# Merge the needed entries into your OWN SSH config. Do not overwrite it.
# No passwords, private keys or tokens belong in this file or repository.
# Verify host fingerprints through a trusted channel on first connection.

Host server-b
    HostName i-2.gpushare.com
    Port 36738
    User root
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 20
    ConnectionAttempts 3
    # Optional: IdentityFile <path to your authorized private key on THIS computer>

Host server-a
    HostName 172.23.219.50
    Port 10044
    User root
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 20
    ConnectionAttempts 3
